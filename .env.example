# MamaCare Backend Environment Variables
# Copy this file to .env and fill in your values

# Server Port (Render/Railway will override this)
PORT=5000

# JWT Secret - Generate a strong random string for production
JWT_SECRET=your_super_secret_jwt_key_here

# For production deployment, set this to your deployed frontend URL
# ALLOWED_ORIGINS=https://your-frontend-url.com,http://localhost:5173
